FROM node:20-alpine AS build

# Prisma's engines do not run on Alpine out of the box: without OpenSSL the
# schema engine returns a non-JSON "Error loading..." payload and the CLI dies
# with "Could not parse schema engine response".
RUN apk add --no-cache openssl libc6-compat

WORKDIR /app
COPY server/package*.json ./
RUN npm ci
COPY server/ .
RUN npx prisma generate
# tsc only. The full "build" also runs five verification scripts, which take
# about twenty seconds on every image build and are of no use here: nothing that
# consumes the image can act on their output, and a failing check should fail a
# commit rather than a deploy. They still run in npm run build locally and on
# the developer machine.
RUN npx tsc

FROM node:20-alpine

# Same runtime requirement for the query engine the app loads on first query.
RUN apk add --no-cache openssl libc6-compat

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/package.json ./

# Загруженные файлы приходят volume-омонтированием из ./server/uploads
RUN mkdir -p /app/uploads

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
