# Used by docker compose only. The deploy workflow reads server/.env instead.
# Copy to .env and fill in.

POSTGRES_DB=flexdb
POSTGRES_USER=flex
POSTGRES_PASSWORD=
JWT_SECRET=
CLIENT_URL=https://veheys.online


TELEGRAM_BOT_TOKEN=

# Web push. The deploy generates a pair on first run and leaves it alone.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@veheys.online
