generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String
  password    String
  telegramId  String?      @unique
  vkId        String?      @unique
  avatarUrl   String?
  dateOfBirth DateTime?
  publicKey   String?

  // Brute-force protection. Without a per-account counter the only brake was a
  // per-IP rate limit, which does nothing against a slow distributed guessing
  // run or one attacker spreading requests across many addresses.
  failedLogins Int        @default(0)
  lockedUntil  DateTime?

  // Bumping this invalidates every access token already issued for the user,
  // which is what makes "log out everywhere" and password changes possible.
  tokenVersion Int        @default(0)

  // AES-256-GCM ciphertext of the TOTP seed; never the plaintext.
  totpSecret   String?
  totpEnabled  Boolean     @default(false)
  /// Timestep of the last accepted code, so the same one cannot be replayed.
  totpLastStep Int?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sessions    Session[]
  recipes     Recipe[]
  tasks       Task[]
  assignedTasks Task[]       @relation("TaskAssignee")
  taskColumns TaskColumn[]
  families    FamilyMember[]
  invites     FamilyInvite[]
  notifications Notification[]
  chats       ChatParticipant[]
  messages    Message[]
  notes       Note[]
  chatKeys    ChatKey[]
  plans       Plan[]
  planEntries PlanEntry[]
  wishlists     Wishlist[]
  wishItems     WishItem[]   @relation("WishItemOwner")
  wishedGifts   WishItem[]   @relation("WishItemRecipient")
  events        CalendarEvent[]
  shoppingItems ShoppingItem[] @relation("ShoppingOwner")
  boughtItems   ShoppingItem[] @relation("ShoppingBuyer")
}

model Family {
  id        String         @id @default(uuid())
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   FamilyMember[]
  invites   FamilyInvite[]
}

model FamilyMember {
  id        String   @id @default(uuid())
  role      String   @default("member")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  @@unique([userId, familyId])
}

model FamilyInvite {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  status    String   @default("pending")
  createdAt DateTime @default(now())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User     @relation(fields: [inviterId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  data      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chat {
  id           String             @id @default(uuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants ChatParticipant[]
  messages     Message[]
  keys         ChatKey[]
}

model ChatKey {
  id        String @id @default(uuid())
  key       String
  chatId    String
  chat      Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([chatId, userId])
}

model ChatParticipant {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, chatId])
}

model Message {
  id        String    @id @default(uuid())
  content   String
  audio         String?
  audioDuration Int?
  image         String?
  readAt        DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  chatId    String
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String       @id @default(uuid())
  title        String
  url          String?
  ingredients  String       @default("[]")
  instructions String       @default("[]")
  cookingTime  Int?
  category     String?
  imageUrl     String?
  isPublic     Boolean      @default(false)
  visibility   String       @default("private")
  familyId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskColumn {
  id        String       @id @default(uuid())
  title     String
  color     String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  priority    Priority?
  dueDate     DateTime?
  order       Int          @default(0)
  visibility  String       @default("private")
  familyId    String?
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  columnId    String
  column      TaskColumn   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A refresh token, stored as a SHA-256 hash so a database read cannot be
/// replayed as a credential. Rotating on every use means a stolen refresh token
/// is single-use: the legitimate client redeems it once and the thief's copy is
/// dead, which `revokedAt` records.
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String?
  images    String?
  audio     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id           String      @id @default(uuid())
  title        String
  description  String?
  targetAmount Int         @default(0)
  deadline     DateTime?
  color        String?
  visibility   String      @default("private")
  familyId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      PlanEntry[]
}

model PlanEntry {
  id        String   @id @default(uuid())
  amount    Int
  type      String   @default("income")
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Priority {
  low
  medium
  high
}

model Wishlist {
  id          String     @id @default(uuid())
  title       String
  description String?
  visibility  String     @default("private")
  familyId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WishItem[]
}

model WishItem {
  id          String    @id @default(uuid())
  title       String
  price       Int?
  url         String?
  note        String?
  priority    Priority?
  bought      Boolean   @default(false)
  boughtAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  wishlistId  String
  wishlist    Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation("WishItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?     @relation("WishItemRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  time        String?
  color       String?
  visibility  String   @default("private")
  familyId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShoppingItem {
  id        String    @id @default(uuid())
  title     String
  quantity  Float?
  unit      String?
  price     Int?
  category  String?
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  familyId  String?
  userId    String
  user      User      @relation("ShoppingOwner", fields: [userId], references: [id], onDelete: Cascade)
  buyerId   String?
  buyer     User?     @relation("ShoppingBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
}
