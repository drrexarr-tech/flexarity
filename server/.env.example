# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/flexdb?schema=public"

# Auth — generate with: openssl rand -base64 24
# Changing it signs everyone out.
JWT_SECRET="change-me"

# Server
PORT=3001
# Where the browser app is served from (CORS origin)
CLIENT_URL="https://veheys.online"

# Email (optional — without it emails are only logged to console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# OAuth (optional)
TELEGRAM_BOT_TOKEN=""
VK_SERVICE_KEY=""
VK_PROTECTED_KEY=""
