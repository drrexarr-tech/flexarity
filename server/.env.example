# Единственный файл с секретами. В git не попадает (см. .gitignore).
#
# Compose читает его и как env_file для контейнера, и как --env-file
# для подстановки переменных, поэтому всё нужно держать здесь.

# --- База данных ---
# PostgreSQL поднят отдельным контейнером (flex-postgres) и в compose не
# описан намеренно — см. комментарий в docker-compose.yml.
# Эти ключи нужны, чтобы подставить параметры подключения для контейнера
# и для хостовых операций вроде npx prisma.
# Внутри контейнера хост БД — host.docker.internal, здесь — localhost.
POSTGRES_DB=flexdb
POSTGRES_USER=flex
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://flex:@localhost:5432/flexdb?schema=public"

# --- Auth ---
# Сгенерировать: openssl rand -base64 24
# Смена значения разлогинивает всех пользователей.
JWT_SECRET=

# --- Сервер ---
PORT=3001
# CORS-origin, откуда приходит браузер
CLIENT_URL="https://veheys.online"

# --- Email (необязательно: без него письма только пишутся в консоль) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- OAuth (необязательно) ---
TELEGRAM_BOT_TOKEN=""
VK_SERVICE_KEY=""
VK_PROTECTED_KEY=""
